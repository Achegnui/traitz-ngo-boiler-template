rules_version = '2';
// NOT USED while uploads go to Cloudinary (no card needed). Keep only if you later enable Firebase Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
