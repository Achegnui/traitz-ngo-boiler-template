# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Also the base of the Fapshi return link. For a local donation test set it to the address `npm run dev` prints, for example http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: DATA_SOURCE=local serves the bundled seed data instead of Firestore (offline dev, CI).
# DATA_SOURCE=local

# Cloudinary (image and PDF uploads in the admin). Only the cloud name is public.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (server only; the donation routes write /donations with it).
# Firebase console > Project settings > Service accounts > Generate new private key (free, no Blaze plan needed).
# Copy client_email and private_key from the downloaded JSON. Never commit that file.
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-key\n-----END PRIVATE KEY-----\n"

# Fapshi mobile money (server only). Personal sandbox keys from the Fapshi dashboard.
# FAPSHI_ENV=sandbox uses https://sandbox.fapshi.com and needs a key that starts with FAK_TEST_.
FAPSHI_ENV=sandbox
FAPSHI_API_USER=your-fapshi-api-user
FAPSHI_API_KEY=FAK_TEST_replace-with-your-key
